# Credenciales de Meta Graph API para programar publicaciones en tu Pagina de Facebook
# Copia este archivo como ".env" en la raiz del proyecto o en "06-automatizaciones/scripts/.env"
# NUNCA subas el archivo ".env" a Git.

FB_PAGE_ID=PEGA_AQUI_TU_PAGE_ID
FB_PAGE_ACCESS_TOKEN=PEGA_AQUI_TU_PAGE_ACCESS_TOKEN
FB_GRAPH_VERSION=v25.0

# Opcional (solo si quieres convertir un User Token temporal de 1 hora en Page Token permanente):
FB_APP_ID=
FB_APP_SECRET=
